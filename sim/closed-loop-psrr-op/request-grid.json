  "measurements": [
    {
      "name": "dvdd_v",
      "expr": "hi.vdd - lo.vdd",
      "unit": "V"
    },
    {
      "name": "dvref_v",
      "expr": "hi.vref - lo.vref",
      "unit": "V"
    },
    {
      "name": "psrr_db",
      "expr": "db(abs(hi.vdd - lo.vdd)/abs(hi.vref - lo.vref))",
      "unit": "dB",
      "plausible_range": {
        "min": 0,
        "max": 140
      }
    },
    {
      "name": "dfb_v",
      "expr": "hi.fb - lo.fb",
      "unit": "V"
    },
    {
      "name": "fb_tracking",
      "expr": "(hi.fb - lo.fb)/(hi.vdd - lo.vdd)",
      "unit": "V/V"
    },
    {
      "name": "dvid_v",
      "expr": "(hi.sns2 - hi.sns1) - (lo.sns2 - lo.sns1)",
      "unit": "V"
    },
    {
      "name": "dvgs_m3_v",
      "expr": "(hi.fb - lo.fb) - (hi.vdd - lo.vdd)",
      "unit": "V"
    },
    {
      "name": "fb_per_dvid",
      "expr": "abs((hi.fb - lo.fb)/((hi.sns2 - hi.sns1) - (lo.sns2 - lo.sns1)))",
      "unit": "V/V"
    },
    {
      "name": "m1_marg_v",
      "expr": "abs(op.m1_vds) - abs(op.m1_vdss)",
      "unit": "V"
    },
    {
      "name": "m2_marg_v",
      "expr": "abs(op.m2_vds) - abs(op.m2_vdss)",
      "unit": "V"
    },
    {
      "name": "m3_marg_v",
      "expr": "abs(op.m3_vds) - abs(op.m3_vdss)",
      "unit": "V"
    },
    {
      "name": "mtail_marg_v",
      "expr": "abs(op.mtail_vds) - abs(op.mtail_vdss)",
      "unit": "V"
    },
    {
      "name": "mp1_marg_v",
      "expr": "abs(op.mp1_vds) - abs(op.mp1_vdss)",
      "unit": "V"
    },
    {
      "name": "mp2_marg_v",
      "expr": "abs(op.mp2_vds) - abs(op.mp2_vdss)",
      "unit": "V"
    },
    {
      "name": "mp3_marg_v",
      "expr": "abs(op.mp3_vds) - abs(op.mp3_vdss)",
      "unit": "V"
    },
    {
      "name": "mp4_marg_v",
      "expr": "abs(op.mp4_vds) - abs(op.mp4_vdss)",
      "unit": "V"
    },
    {
      "name": "mn1_marg_v",
      "expr": "abs(op.mn1_vds) - abs(op.mn1_vdss)",
      "unit": "V"
    },
    {
      "name": "mn2_marg_v",
      "expr": "abs(op.mn2_vds) - abs(op.mn2_vdss)",
      "unit": "V"
    },
    {
      "name": "mn3_marg_v",
      "expr": "abs(op.mn3_vds) - abs(op.mn3_vdss)",
      "unit": "V"
    },
    {
      "name": "mn4_marg_v",
      "expr": "abs(op.mn4_vds) - abs(op.mn4_vdss)",
      "unit": "V"
    },
    {
      "name": "msense_marg_v",
      "expr": "abs(op.msense_vds) - abs(op.msense_vdss)",
      "unit": "V"
    },
    {
      "name": "mkfb_marg_v",
      "expr": "abs(op.mkfb_vds) - abs(op.mkfb_vdss)",
      "unit": "V"
    },
    {
      "name": "av1",
      "expr": "op.mp1_gm/(op.mn1_gm + op.mn1_gds + op.mp1_gds)",
      "unit": "V/V"
    },
    {
      "name": "gm2_s",
      "expr": "op.mn3_gm + op.mp4_gm*op.mn4_gm/(op.mp3_gm + op.mp3_gds + op.mn4_gds)",
      "unit": "S"
    },
    {
      "name": "rout_ohm",
      "expr": "1/(op.mn3_gds + op.mp4_gds)",
      "unit": "ohm"
    },
    {
      "name": "av_amp_derived",
      "expr": "0.5*(op.mp1_gm/(op.mn1_gm + op.mn1_gds + op.mp1_gds))*(op.mn3_gm + op.mp4_gm*op.mn4_gm/(op.mp3_gm + op.mp3_gds + op.mn4_gds))/(op.mn3_gds + op.mp4_gds)",
      "unit": "V/V"
    },
    {
      "name": "dids_m3_a",
      "expr": "hi.m3_ids - lo.m3_ids",
      "unit": "A"
    },
    {
      "name": "dids_m3_predicted_a",
      "expr": "op.m3_gm*((hi.vdd - lo.vdd) - (hi.fb - lo.fb)) + op.m3_gds*((hi.vdd - lo.vdd) - (hi.vref - lo.vref))",
      "unit": "A"
    },
    {
      "name": "dids_m3_gds_term_a",
      "expr": "op.m3_gds*((hi.vdd - lo.vdd) - (hi.vref - lo.vref))",
      "unit": "A"
    },
    {
      "name": "dids_m3_gm_term_a",
      "expr": "op.m3_gm*((hi.vdd - lo.vdd) - (hi.fb - lo.fb))",
      "unit": "A"
    },
    {
      "name": "rbranch_ohm",
      "expr": "(hi.vref - lo.vref)/(hi.m3_ids - lo.m3_ids)",
      "unit": "ohm"
    },
    {
      "name": "r1_ohm",
      "expr": "(op.vref - op.e3)/op.m3_ids",
      "unit": "ohm"
    },
    {
      "name": "r2_ohm",
      "expr": "(op.sns2 - op.e2)/op.m2_ids",
      "unit": "ohm"
    }
  ],
  "options": {
    "timeout_s": 120,
    "keep_artifacts": true,
    "stage_model_inputs": true,
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13cmos5l/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "ngspice_init": [
      "set numdgt=12",
      "set measureprec=12"
    ],
    "ngspice_options": {
      "reltol": 1e-08,
      "vntol": 1e-10,
      "abstol": 1e-14
    }
  },
  "batch": {
    "job_ceiling_check": "enforce"
  }
}
